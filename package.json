      "default": "./react/charts/index.ts"
    },
    "./react/icons": {
      "types": "./react/icons/index.d.ts",
      "import": "./react/icons/index.ts",
      "default": "./react/icons/index.ts"
    },
    "./react/Logo": {
      "types": "./react/icons/Logo.d.ts",
      "import": "./react/icons/Logo.tsx",
      "default": "./react/icons/Logo.tsx"

{
  "name": "react-ggn-visual",
  "version": "0.3.0",
  "description": "Shared design tokens and React UI primitives (SoftList, charts, cards, tables)",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "tokens.css",
    "tokens.scss",
    "bootstrap-map.scss",
    "react",
    "README.md"
  ],
  "exports": {
    ".": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./tokens.scss": "./tokens.scss",
    "./bootstrap-map.scss": "./bootstrap-map.scss",
    "./react": {
      "types": "./react/index.d.ts",
